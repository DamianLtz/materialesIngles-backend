PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=materiales_ingles
DB_USERNAME=materiales
DB_PASSWORD=

# Firma de la cookie de sesión. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# OAuth de Google (Google Cloud Console → Credenciales). El redirect URI debe estar
# registrado ahí tal cual. En dev pasa por el proxy de Vite (:5173).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Emails (separados por coma) que pueden exportar el listado de escuelas a Excel
EXPORTAR_ESCUELAS_EMAILS=
